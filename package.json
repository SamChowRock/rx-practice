{
  "name": "rxjs-log-console-course",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node app/server.mjs",
    "lab": "node tools/labs.mjs",
    "transfer": "node tools/labs.mjs --transfer",
    "stage": "node labs/checkpoint.ts",
    "test": "node --test tests/*.test.ts && node tools/labs.mjs && node tools/labs.mjs --transfer && node tools/index.mjs --check && node tools/transfer-index.mjs --check",
    "check": "tsc --noEmit",
    "index": "node tools/index.mjs && node tools/transfer-index.mjs"
  },
  "dependencies": {"rxjs": "7.8.2", "ws": "^8.18.3"},
  "devDependencies": {"typescript": "5.9.3", "@types/node": "24.3.1", "esbuild": "0.25.1"}
}
